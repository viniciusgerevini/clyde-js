{
  "name": "@clyde-lang/vscode",
  "displayName": "Clyde Dialogue Language",
  "version": "0.0.1",
  "private": false,
  "description": "Clyde Dialogue Language tools and LSP support",
  "categories": [
    "Programming Languages"
  ],
  "license": "MIT",
  "author": "Vinicius Gerevini (thisisvini.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/viniciusgerevini/clyde-js.git"
  },
  "publisher": "viniciusgerevini",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "tsc",
    "build:server": "yarn workspace @clyde-lang/language-server build",
    "copy-server": "cp -R ../language_server/dist/ ./server_dist/",
    "pre-commit": "lint-staged",
    "watch": "tsc -b -w",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.137.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "^0.28.2",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "yarn run lint"
  },
  "contributes": {
    "languages": [
      {
        "id": "clyde",
        "aliases": [
          "Clyde",
          "clyde"
        ],
        "extensions": [
          ".clyde"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.100.0"
  }
}
