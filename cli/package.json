{
  "name": "@clyde-lang/cli",
  "version": "4.0.1",
  "description": "CLI tool for executing, parsing and debugging Clyde dialogue files",
  "license": "MIT",
  "author": "Vinicius Gerevini <thisisvini.com>",
  "bin": {
    "clyde": "./dist/cjs/cli.js"
  },
  "files": [
    "./dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/mjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublish": "npm run build",
    "build": "rm -rf dist/* && tsc -p tsconfig.json && tsc-esm-fix --target dist/mjs && tsc -p tsconfig-cjs.json && ./configure_dist_modules",
    "test": "jest --coverage",
    "start": "node ./dist/cjs/cli.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "pre-commit": "lint-staged",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@clyde-lang/interpreter": "5.0.1",
    "@clyde-lang/parser": "2.7.0",
    "yargs": "^16.2.0"
  },
  "devDependencies": {
    "@types/jest": "^28.1.1",
    "@types/yargs": "^17.0.10",
    "jest": "^28.1.1",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "ts-jest": "^28.0.4",
    "tsc-esm-fix": "^2.18.0",
    "typescript": "^4.7.3"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "yarn run lint"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
