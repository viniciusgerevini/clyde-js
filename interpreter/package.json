{
  "name": "@clyde-lang/interpreter",
  "version": "5.0.0",
  "description": "Interpreter for Clyde dialogue language",
  "license": "MIT",
  "author": "Vinicius Gerevini <thisisvini.com>",
  "files": [
    "./dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/mjs/index.js",
  "types": "./dist/mjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublish": "npm run build",
    "build": "rm -rf dist/* && tsc -p tsconfig.json && tsc-esm-fix --target dist/mjs && tsc -p tsconfig-cjs.json && ./configure_dist_modules",
    "test": "jest --coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@clyde-lang/parser": "2.6.0"
  },
  "devDependencies": {
    "@types/jest": "^28.1.1",
    "jest": "^28.1.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "ts-jest": "^28.0.4",
    "tsc-esm-fix": "^2.18.0",
    "typescript": "^4.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
